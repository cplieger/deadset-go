A command whose a.go and b.go each hold an init function with a dead store,
written at the same byte of each file, and a line directive renders both at the
same line of a.go. They are two inits, so each store is reported.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}}
-- a.go --
package main

//line a.go:4:1
func init() {
	v := 1
	v = 2
	_ = v
}

func main() {}
-- b.go --
package main

//line a.go:4:1
func init() {
	w := 1
	w = 2
	_ = w
}
