A target of two modules: m hands out a Square as a Shaper, and b, which requires m,
asserts m's Namer on it and encodes the asserted value. Each module reads lib on its
own, so the site the assertion derives pairs m's Square with the Namer b names, and
the encoder, called from b, asks for the types converted to b's Namer. The encoder
reads Secret.

-- deadset.json --
{"target": {"kind": "application"}}
-- m/go.mod --
module example.com/m

go 1.27
-- m/lib/lib.go --
// Package lib declares a shape and the interfaces it reaches.
package lib

// Shaper is what the source hands out.
type Shaper interface{ Area() int }

// Namer is what b asserts.
type Namer interface{ Name() string }

// Square is the shape the source returns.
type Square struct {
	Secret string
}

// Area makes Square a Shaper.
func (*Square) Area() int { return 4 }

// Name is reached only through b's assertion of Namer.
func (*Square) Name() string { return "square" }
-- m/src/src.go --
// Package src hands out a shape.
package src

import "example.com/m/lib"

// Get returns a Square as a Shaper.
func Get() lib.Shaper { return &lib.Square{Secret: "s"} }
-- m/main.go --
package main

import (
	"fmt"

	"example.com/m/src"
)

func main() { fmt.Println(src.Get().Area()) }
-- b/go.mod --
module example.com/b

go 1.27

require example.com/m v0.0.0

replace example.com/m => ../m
-- b/main.go --
package main

import (
	"encoding/json"
	"fmt"

	"example.com/m/lib"
	"example.com/m/src"
)

func main() {
	if n, ok := src.Get().(lib.Namer); ok {
		out, _ := json.Marshal(n)
		fmt.Println(n.Name(), string(out))
	}
}
