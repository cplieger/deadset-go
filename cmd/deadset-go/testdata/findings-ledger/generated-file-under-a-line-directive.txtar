A command whose generated parser renders a dead function, under a line directive,
in the grammar it was generated from. The function is written in a generated file,
so nothing is reported about it.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

func main() { parse() }
-- parser.go --
// Code generated by goyacc. DO NOT EDIT.

package main

func parse() {}

//line parser.y:10
func yyUnused() {}
-- parser.y --
%{
package main
%}
%%
top: ;
%%
// a grammar line long enough for every byte parser.go's directive renders here 0
// a grammar line long enough for every byte parser.go's directive renders here 1
// a grammar line long enough for every byte parser.go's directive renders here 2
// a grammar line long enough for every byte parser.go's directive renders here 3
