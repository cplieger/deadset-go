main calls hook, a package variable of a function type that no file writes, only
where it is not nil. The call reaches no function, so the payload reaches no
encoder and its Hidden field is unused.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

type payload struct {
	Shown  int
	Hidden int
}

var hook func(any) error

func main() {
	p := &payload{Shown: 1}
	if hook != nil {
		_ = hook(p)
	}
	println(p.Shown)
}
