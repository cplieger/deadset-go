A command analysed for linux and windows. The type-switch case of describe and the
store to c in tally are found by one configuration only: under linux thing has the
Name method named declares and counter's bump takes a pointer, under windows thing
has no Name and bump takes a value. A part both configurations report, the case of
always and the store to n in twice, stays reported.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}, "analysis": {"configurations": [
  {"id": "linux-amd64", "os": "linux", "arch": "amd64"},
  {"id": "windows-amd64", "os": "windows", "arch": "amd64"}]}}
-- main.go --
package main

type named interface{ Name() string }

type thing struct{}

type counter struct{ n int }

func main() { println(describe(thing{}), always(1), tally(), twice()) }

func describe(v any) string {
	switch v.(type) {
	case named:
		return "named"
	case thing:
		return "thing"
	}
	return ""
}

func always(v any) string {
	switch v.(type) {
	case any:
		return "any"
	case int:
		return "int"
	}
	return ""
}

func tally() int {
	var c counter
	c.bump()
	c = counter{n: 2}
	return 0
}

func twice() int {
	n := 1
	println(n)
	n = 2
	return 0
}
-- thing_linux.go --
package main

func (thing) Name() string { return "thing" }

func (c *counter) bump() { c.n++ }
-- thing_windows.go --
package main

func (c counter) bump() { println(c.n) }
