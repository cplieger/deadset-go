A command whose a.go and b.go each hold an unreferenced function with a dead
store, both written at the same byte and rendered by a line directive at the same
line of main.go. They are two declarations, each with its own store.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}}
-- a.go --
package main

//line main.go:20:1
func alpha() {
	v := 1
	v = 2
	_ = v
}
-- b.go --
package main

//line main.go:20:1
func bravo() {
	v := 1
	v = 2
	_ = v
}
-- main.go --
package main

func main() {}
