A command that fills a request through a dependency's binder and reads one of its
fields. The other field carries a directive: its finding would be possible, because
the binder fills it and may read it, so the default minimum withholds the finding
and the directive is dormant rather than in effect.

-- go.mod --
module example.com/app

go 1.27.0

require example.com/plugin v0.0.0

replace example.com/plugin => ./plugin
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import "example.com/plugin"

type request struct {
	Name string `json:"name"`
	//deadset:ignore DS1003 -- the binder fills it
	Extra string `json:"extra"`
}

func main() {
	var c plugin.Context
	var req request
	_ = c.BindJSON(&req)
	println(req.Name)
}
-- plugin/go.mod --
module example.com/plugin

go 1.27.0
-- plugin/plugin.go --
// Package plugin fills values.
package plugin

import "encoding/json"

// Binding fills a value from a body.
type Binding interface {
	Bind(body []byte, v any) error
}

type jsonBinding struct{}

func (jsonBinding) Bind(body []byte, v any) error { return json.Unmarshal(body, v) }

// Context is one request.
type Context struct {
	body    []byte
	binding Binding
}

// BindJSON fills v from the body through the context's binding.
func (c *Context) BindJSON(v any) error { return c.binding.Bind(c.body, v) }
