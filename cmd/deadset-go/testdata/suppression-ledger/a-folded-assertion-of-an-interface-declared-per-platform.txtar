A line directive renders the linux declaration of an interface declared once
per platform and its assertion under gen.proto. The assertion is one finding,
at the position the directive gives it, holding under both configurations.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}, "analysis": {"configurations": [
  {"id": "linux-amd64", "os": "linux", "arch": "amd64"},
  {"id": "windows-amd64", "os": "windows", "arch": "amd64"}]}}
-- main.go --
package main

func main() { _ = impl{}.write() }

type impl struct{}

func (impl) write() int { return 2 }
-- iface_linux.go --
package main

//line gen.proto:1:1
type writer interface {
	write() int
}
-- iface_windows.go --
package main

type writer interface {
	write() int
}
-- a.go --
package main

//line gen.proto:20:1
var _ writer = impl{}
-- gen.proto --
