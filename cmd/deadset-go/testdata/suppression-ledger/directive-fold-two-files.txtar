A directive in a.go binds the declaration a.go writes below it, though a line
directive in b.go renders bravo on that line: bravo is reported.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}}
-- a.go --
package main

//line main.go:19:1
//deadset:ignore DS1002 -- kept for the loader
func alpha() {}
-- b.go --
package main

//line main.go:20:1
func bravo() {}
-- main.go --
package main

func main() {}
