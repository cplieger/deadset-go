An interface is declared once per platform and asserted from a file both
configurations compile. The assertion is one declaration, so it is one
finding holding under both configurations, whichever declaration of the
interface each configuration names.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}, "analysis": {"configurations": [
  {"id": "linux-amd64", "os": "linux", "arch": "amd64"},
  {"id": "windows-amd64", "os": "windows", "arch": "amd64"}]}}
-- main.go --
package main

func main() { _ = impl{}.write() }

type impl struct{}

func (impl) write() int { return 2 }
-- iface_linux.go --
package main

type writer interface {
	write() int
}
-- iface_windows.go --
package main

type writer interface {
	write() int
}
-- a.go --
package main

var _ writer = impl{}
