A line directive inside compute renders its dead store under gen.txt. One
ignore entry names compute's reference at main.go, the file compute renders
under, which is not the path the store reports. The store is reported at
gen.txt and the entry is stale.

-- go.mod --
module example.com/app

go 1.27
-- deadset.json --
{"target": {"kind": "application"}}
-- deadset-ignore.json --
{"ignore": [{"code": "DS1404", "symbol": "go://example.com/app#compute", "path": "main.go", "reason": "wanted"}]}
-- main.go --
package main

func main() { println(compute()) }

func compute() int {
	v := 1
	_ = v
//line gen.txt:40:1
	v = 2
	return 3
}
