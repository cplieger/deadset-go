Only a test file converts an integer to mode, so a production run holds no evidence
that a value no name gives can arise, and deleting slow there only renumbers
turbo consistently. Over every file the test's conversion keeps slow, so it is
kept for tests alone.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"fmt"
	"os"
)

type mode int

const (
	fast mode = iota
	slow
	turbo
)

func main() {
	m := fast
	if len(os.Args) > 1 {
		m = turbo
	}
	fmt.Println(m == turbo)
}
-- a_test.go --
package main

import "testing"

func TestMode(t *testing.T) {
	if mode(len(t.Name())) == fast {
		t.Fatal("zero")
	}
}
