Two sets each parse one file defining the same template, and one function
executes whichever set it is handed. Which definition the call reaches depends
on the set, and one writes its value as JSON whole, so the program's templates
read every field.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- views/script.html --
{{define "content"}}<script>var s = {{.}};</script>{{end}}
-- views/name.html --
{{define "content"}}<p>{{.Name}}</p>{{end}}
-- app.go --
package main

import (
	"html/template"
	"os"
)

var (
	scripts = template.Must(template.ParseFiles("views/script.html"))
	names   = template.Must(template.ParseFiles("views/name.html"))
)

type Page struct {
	Name   string
	Secret string
}

func render(set *template.Template) {
	_ = set.ExecuteTemplate(os.Stdout, "content", Page{Name: "n", Secret: "s"})
}

func main() {
	if os.Getenv("VIEW") == "script" {
		render(scripts)
		return
	}
	render(names)
}
