Each set parses one of two texts or files the environment picks: a Parse text, a
ParseFiles name, a ParseGlob pattern, a ParseFS pattern and a ParseFS file
system. Both alternatives define the same template, and the program parses only
the one it picks, so the set does not know which definition it holds. One writes
its value as JSON whole, so each set reads every field.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- views/script.html --
{{define "content"}}<script>var s = {{.}};</script>{{end}}
-- views/name.html --
{{define "content"}}<p>{{.Name}}</p>{{end}}
-- a/page.html --
{{define "content"}}<script>var s = {{.}};</script>{{end}}
-- b/page.html --
{{define "content"}}<p>{{.Name}}</p>{{end}}
-- app.go --
package main

import (
	"embed"
	"html/template"
	"io/fs"
	"os"
)

//go:embed views
var views embed.FS

const (
	scriptView = `{{define "content"}}<script>var s = {{.}};</script>{{end}}`
	nameView   = `{{define "content"}}<p>{{.Name}}</p>{{end}}`
)

func scripted() bool { return os.Getenv("VIEW") == "script" }

func text() string {
	if scripted() {
		return scriptView
	}
	return nameView
}

func file() string {
	if scripted() {
		return "views/script.html"
	}
	return "views/name.html"
}

func glob() string {
	if scripted() {
		return "views/script*.html"
	}
	return "views/name*.html"
}

func root() fs.FS {
	if scripted() {
		return os.DirFS("a")
	}
	return os.DirFS("b")
}

type Text struct {
	Name   string
	Secret string
}

type File struct {
	Name   string
	Secret string
}

type Glob struct {
	Name   string
	Secret string
}

type Pattern struct {
	Name   string
	Secret string
}

type Root struct {
	Name   string
	Secret string
}

var (
	textSet    = template.Must(template.New("page").Parse(text()))
	fileSet    = template.Must(template.ParseFiles(file()))
	globSet    = template.Must(template.ParseGlob(glob()))
	patternSet = template.Must(template.ParseFS(views, file()))
	rootSet    = template.Must(template.ParseFS(root(), "*.html"))
)

func main() {
	_ = textSet.ExecuteTemplate(os.Stdout, "content", Text{Name: "n", Secret: "s"})
	_ = fileSet.ExecuteTemplate(os.Stdout, "content", File{Name: "n", Secret: "s"})
	_ = globSet.ExecuteTemplate(os.Stdout, "content", Glob{Name: "n", Secret: "s"})
	_ = patternSet.ExecuteTemplate(os.Stdout, "content", Pattern{Name: "n", Secret: "s"})
	_ = rootSet.ExecuteTemplate(os.Stdout, "content", Root{Name: "n", Secret: "s"})
}
