mid embeds selfish and wrap embeds mid, so the MarshalJSON promoted twice is
in wrap's method set and encoding/json marshals a wrap by calling it: the
method is read, and selfish's field Z is not.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"encoding/json"
	"fmt"
)

type selfish struct{ Z int }

func (selfish) MarshalJSON() ([]byte, error) { return []byte("1"), nil }

type mid struct{ selfish }

type wrap struct{ mid }

func main() { out, _ := json.Marshal(wrap{}); fmt.Println(string(out)) }
