wrap embeds selfish, whose MarshalXML encoding/xml calls on a wrap through
promotion, walking no field.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"encoding/json"
	"fmt"
	"encoding/xml"
)

var _ = json.Marshal
var _ = xml.Marshal

type selfish struct{ Z int }

func (selfish) MarshalXML(*xml.Encoder, xml.StartElement) error { return nil }

type wrap struct{ selfish }

func main() {
	out, _ := xml.Marshal(wrap{}); fmt.Println(out)
}
