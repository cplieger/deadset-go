An iota enum a decoder fills keeps a member whose deletion renumbers a member
code names when a line directive renders its type in a file outside the tree:
the file that writes the type is the target's.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- level.go --
package main

//line /elsewhere/level.go:1
type Level int

const (
	Low Level = iota
	Mid
	High
)
-- app.go --
package main

import (
	"encoding/json"
	"fmt"
	"os"
)

type Config struct {
	Level Level `json:"level"`
}

func main() {
	var c Config
	if err := json.NewDecoder(os.Stdin).Decode(&c); err != nil {
		os.Exit(1)
	}
	fmt.Println(c.Level == High)
}
