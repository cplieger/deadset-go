A function enumerates the fields of the value it is given by reflection and names
those that are set. A walk over a type's fields reads every field, so a field
nothing writes is read too.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- app.go --
package main

import "reflect"

type HTTPTarget struct {
	URI  string
	Body string
}

func fieldMasks(v any) []string {
	val := reflect.ValueOf(v)
	var names []string
	for i := range val.NumField() {
		if !val.Field(i).IsZero() {
			names = append(names, val.Type().Field(i).Name)
		}
	}
	return names
}

func main() { println(len(fieldMasks(HTTPTarget{URI: "u"}))) }
