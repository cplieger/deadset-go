wrap embeds selfish, whose MarshalText encoding/json calls to spell a map key of
type wrap through promotion.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"encoding/json"
	"fmt"
	"encoding/xml"
)

var _ = json.Marshal
var _ = xml.Marshal

type selfish struct{ Z int }

func (selfish) MarshalText() ([]byte, error) { return nil, nil }

type wrap struct{ selfish }

func main() {
	out, _ := json.Marshal(map[wrap]int{}); fmt.Println(out)
}
