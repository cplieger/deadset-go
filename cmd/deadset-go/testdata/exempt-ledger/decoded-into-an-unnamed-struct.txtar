A document is decoded into a field whose type is a struct with no name, through a
pointer to that field, and the whole value is encoded again, so the encoder reads
every field the decoder filled.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- app.go --
package main

import (
	"encoding/json"
	"os"
)

type document struct {
	Meta struct {
		Note string `json:"note"`
	} `json:"meta"`
	Spare string `json:"-"`
}

func main() {
	var d document
	if json.NewDecoder(os.Stdin).Decode(&d.Meta) != nil {
		return
	}
	_ = json.NewEncoder(os.Stdout).Encode(d)
}
