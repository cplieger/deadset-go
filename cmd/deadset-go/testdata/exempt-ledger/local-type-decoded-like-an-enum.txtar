A block declares a local type mode that shadows the enumerated mode and decodes
into a field of it. That decodes no enumeration, so slow stays unused.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"encoding/json"
	"fmt"
)

type mode int

const (
	fast mode = iota
	slow
)

func main() {
	fmt.Println(fast)
	{
		type mode int
		var v struct{ M mode }
		_ = json.Unmarshal([]byte(`{"M":1}`), &v)
		fmt.Println(v.M)
	}
}
