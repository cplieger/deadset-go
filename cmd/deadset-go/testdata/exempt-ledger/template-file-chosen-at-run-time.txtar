A page parses one embedded file the environment names. Both files define the
same template, and the program parses only the one it names, so the set does not
know which definition it holds. One writes its value as JSON whole, so the set
reads every field.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- views/a.html --
{{define "content"}}<script>var s = {{.}};</script>{{end}}
-- views/b.html --
{{define "content"}}<p>{{.Name}}</p>{{end}}
-- app.go --
package main

import (
	"embed"
	"html/template"
	"os"
)

//go:embed views
var views embed.FS

var raw, _ = views.ReadFile(os.Getenv("VIEW"))

var pages = template.Must(template.New("page").Parse(string(raw)))

type Page struct {
	Name   string
	Secret string
}

func main() {
	_ = pages.ExecuteTemplate(os.Stdout, "content", Page{Name: "n", Secret: "s"})
}
