Two functions instantiate view with a local type e each. The unsafe conversion
lays out both type arguments, so alpha.X and bravo.Y are read.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"fmt"
	"unsafe"
)

type alpha struct{ X int }

type bravo struct{ Y int }

func view[T any](b []byte) *T { return (*T)(unsafe.Pointer(&b[0])) }

var buf = make([]byte, 64)

func one() {
	type e struct{ A alpha }
	fmt.Println(view[e](buf) != nil)
}

func two() {
	type e struct{ B bravo }
	fmt.Println(view[e](buf) != nil)
}

func main() {
	one()
	two()
}
