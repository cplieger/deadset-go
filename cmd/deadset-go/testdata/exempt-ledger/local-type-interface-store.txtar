Two functions store a local type e in box.V, each holding another struct.
Encoding the box reads what each e holds, so alpha.X and bravo.Y are read.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"encoding/json"
	"fmt"
)

type alpha struct{ X int }

type bravo struct{ Y int }

type box struct{ V any }

func one() box {
	type e struct{ A alpha }
	return box{V: e{A: alpha{X: 1}}}
}

func two() box {
	type e struct{ B bravo }
	return box{V: e{B: bravo{Y: 2}}}
}

func main() {
	for _, b := range []box{one(), two()} {
		out, _ := json.Marshal(b)
		fmt.Println(string(out))
	}
}
