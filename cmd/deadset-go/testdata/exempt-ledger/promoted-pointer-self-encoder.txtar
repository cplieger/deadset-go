wrap embeds selfish, whose MarshalJSON has a pointer receiver; json.Marshal of a
*wrap meets an addressable wrap and calls the promoted method, which never reads Z.

-- go.mod --
module example.com/app

go 1.27.1
-- deadset.json --
{"target": {"kind": "application"}}
-- main.go --
package main

import (
	"encoding/json"
	"fmt"
	"encoding/xml"
)

var _ = json.Marshal
var _ = xml.Marshal

type selfish struct{ Z int }

func (*selfish) MarshalJSON() ([]byte, error) { return nil, nil }

type wrap struct{ selfish }

func main() {
	out, _ := json.Marshal(&wrap{}); fmt.Println(out)
}
