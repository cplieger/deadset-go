A function that overwrites a local before anything reads it, a function whose last
store nothing reads, a function every store of which a read reaches, and a function
that overwrites a local a closure written after both stores reads, then stores to it
after the closure. A further file stores to results and a
parameter: results a return naming values overwrites, results a bare return reads, a
result a deferred closure reads, and a parameter stored after its last read; and to a
pointer a pointer method is called through, beside a value a pointer method takes
the address of.

-- go.mod --
module example.com/app

go 1.27.1
-- main.go --
package main

// overwritten stores twice and the first store reaches no read.
func overwritten() int {
	count := 1
	count = 2
	return count
}

// trailing stores after its last read.
func trailing() int {
	count := 1
	total := count
	count = 2
	return total
}

// threaded reads every store it makes, so nothing reports one.
func threaded() int {
	count := 1
	count = count + 2
	return count
}

// captured overwrites its local before a closure reads it, then stores to it after
// the closure is written, which a call no graph orders may read.
func captured() func() int {
	count := 1
	count = 2
	read := func() int { return count }
	count = 3
	return read
}

// immediate calls a closure where it writes it, which reads its local there and
// nowhere later, so the store after the call reaches no read.
func immediate() {
	seen := 0
	func() { println(seen) }()
	seen = 1
}

// spawned starts a closure in a goroutine, which may read its local at any time.
func spawned() {
	seen := 0
	go func() { println(seen) }()
	seen = 1
}

func main() {
	immediate()
	spawned()
	println(overwritten(), trailing(), threaded(), captured()())
	println(scraped(true))
	println(bare())
	println(deferred(), rebound(1), requeried(), addressed())
}
-- signature.go --
package main

// scraped stores results that the return naming values overwrites.
func scraped(fail bool) (label string, err error) {
	if fail {
		label, err = parse()
	} else {
		label, err = parse()
	}
	return label, nil
}

// bare returns its results by a return naming none, which reads them.
func bare() (label string, err error) {
	label, err = parse()
	return
}

// deferred reads its result in a deferred closure, which no graph orders, so
// nothing reports a store to it.
func deferred() (err error) {
	defer func() { _ = err }()
	_, err = parse()
	return nil
}

// rebound stores to its parameter after the parameter's last read.
func rebound(n int) int {
	total := n
	n = 0
	return total
}

// requeried calls a method through a pointer it holds, then overwrites the pointer
// before anything reads it.
func requeried() int {
	c := newCounter()
	n := c.next()
	c = newCounter()
	return n
}

// addressed calls a pointer method on a value it holds, which takes the value's
// address, so nothing reports a store to it.
func addressed() int {
	var c counter
	n := c.next()
	c = counter{}
	return n
}

type counter struct{ n int }

func newCounter() *counter { return &counter{} }

func (c *counter) next() int {
	c.n++
	return c.n
}

func parse() (string, error) { return "", nil }
