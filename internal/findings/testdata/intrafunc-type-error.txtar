package main

type cursor struct{ n int }

func (c *cursor) Filter(idx int) error {
	c.n = 0
	return nil
}

func open() Missing { return &cursor{} }

type plain struct{ n int }

func (p *plain) Use(x int) { p.n = 0 }

func main() {
	var p plain
	p.Use(1)
}
