A function holding a statement after a return, a function value a package
variable holds with the same statement, and a function whose every statement
control flow reaches.

-- go.mod --
module example.com/app

go 1.27.1
-- main.go --
package main

// halted returns before its last statement, which nothing reaches.
func halted() {
	println("before the return")
	return
	println("after the return")
}

// reached ends on its return, so nothing reports a statement of it.
func reached() {
	println("before the return")
	return
}

// deferred is a function value whose last statement nothing reaches.
var deferred = func() {
	println("before the return")
	return
	println("after the return")
}

func main() {
	halted()
	reached()
	deferred()
}
