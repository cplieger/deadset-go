Every directive shape the module file's grammar writes, so that the reading is
exercised over a block and a single line, a quoted path, a directive that names a
version and one that does not, a replacement to a module and one to a directory,
and the directives no rule reads.

-- go.mod --
module example.com/app

go 1.27.1

godebug default=go1.27

require (
	example.com/direct v1.2.3
	example.com/indirect v0.4.0 // indirect
)

require "example.com/quoted" v1.0.0

exclude example.com/direct v1.3.0

replace (
	example.com/direct v1.2.3 => example.com/fork v1.2.4
	example.com/indirect => ./local
)

replace example.com/single/v2 => example.com/fork/v2 v2.0.0

retract v1.0.1

tool example.com/direct/cmd/gen
-- app.go --
package app

// Answer returns a number.
func Answer() int { return 1 }
