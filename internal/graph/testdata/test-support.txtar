	}
}
-- shared/shared.go --
package shared

// Both is called by a test and by the command's package.
func Both() int { return 4 }
-- shared/shared_test.go --
package shared_test

import (
	"testing"

	"example.com/support/shared"
)

func TestBoth(t *testing.T) {
	if shared.Both() != 4 {
		t.Error("both")
	}
}
-- uses/uses.go --
package uses

import "example.com/support/shared"

// Total is production code a test calls, so shared stays production.
func Total() int { return shared.Both() }
-- uses/uses_test.go --
package uses

import "testing"

func TestTotal(t *testing.T) {
	if Total() != 4 {
		t.Error("total")
	}
}
-- uses/link.go --
package uses

import _ "example.com/support/tiedup"
-- tiedup/tiedup.go --
package tiedup

// Tied is reached by a production blank import.
func Tied() int { return 5 }
-- tiedup/tiedup_test.go --
package tiedup

import "testing"

func TestTied(t *testing.T) {
	if Tied() != 5 {
		t.Error("tied")
	}
}
-- unreached/unreached.go --
package unreached

// Alone is reached by nothing.
func Alone() int { return 6 }
