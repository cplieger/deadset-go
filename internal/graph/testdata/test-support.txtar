One module: a command, a production package with an interface and its own test,
and beside them every shape of package only tests reach and every shape that
production code or a root reaches as well.

-- go.mod --
module example.com/support

go 1.27.1
-- main.go --
package main

import (
	"example.com/support/store"
	"example.com/support/uses"
)

func main() { println(store.Count(nil), uses.Total()) }
-- store/store.go --
package store

// Store is what Count reads through.
type Store interface {
	Len() int
}

// Count calls through the interface, which references no implementation.
func Count(s Store) int {
	if s == nil {
		return 0
	}
	return s.Len()
}
-- store/store_test.go --
package store_test

import (
	"testing"

	"example.com/support/fake"
	"example.com/support/store"
)

func TestCount(t *testing.T) {
	if store.Count(fake.New()) != 1 {
		t.Error("count")
	}
}
-- fake/fake.go --
package fake

import "example.com/support/chain"

// Memory implements store.Store.
type Memory struct{}

// Len reports one.
func (Memory) Len() int { return chain.One() }

// New returns a fake store.
func New() Memory { return Memory{} }
-- chain/chain.go --
package chain

// One is called by the fake alone.
func One() int { return 1 }
-- internal/own/own.go --
package own

// Helper is called by this package's own test alone.
func Helper() int { return 2 }
-- internal/own/own_test.go --
package own

import "testing"

func TestHelper(t *testing.T) {
	if Helper() != 2 {
		t.Error("helper")
	}
}
-- withinit/withinit.go --
package withinit

var started int

func init() { started = 1 }

var _ = started

// Started is called by a test alone.
func Started() int { return started }
-- withinit/withinit_test.go --
package withinit_test

import (
	"testing"

	"example.com/support/withinit"
)

func TestStarted(t *testing.T) {
	if withinit.Started() != 1 {
		t.Error("started")
	}
}
