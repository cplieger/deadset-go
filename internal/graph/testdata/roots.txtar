-- api_test.go --
package roots

import (
	"fmt"
	"testing"
)

func TestMain(m *testing.M) { m.Run() }

func TestPublished(t *testing.T) {
	if got := Published(); got != "" {
		t.Errorf("Published() = %q, want %q", got, "")
	}
}

func BenchmarkPublished(b *testing.B) {
	for b.Loop() {
		_ = Published()
	}
}

func FuzzPublished(f *testing.F) {
	f.Add("")
	f.Fuzz(func(t *testing.T, in string) { _ = in })
}

func ExampleWithOutput() {
	fmt.Println("published")
	// Output: published
}

func ExampleWithoutOutput() { _ = Published() }

// ExampleTakesAnArgument carries the family prefix and not the signature.
func ExampleTakesAnArgument(size int) { _ = size }

// TestingLower carries the signature and not the prefix: the rune after Test is
// lower case.
func TestingLower(t *testing.T) { _ = t }

// HelperExported carries the signature and no family prefix at all.
func HelperExported(t *testing.T) { _ = t }
