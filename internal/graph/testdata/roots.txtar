One module holding, for each detected root class, a declaration the class roots
and a declaration that carries everything about it except what makes it a root.

-- go.mod --
module example.com/roots

go 1.27.1
-- api.go --
package roots

import (
	"errors"
	"testing"
)

// Published is an exported function of an importable package.
func Published() string { return unpublished() }

func unpublished() string { return "" }

// Catalog carries an exported and an unexported field.
type Catalog struct {
	Name string
	size int
}

// Resolve is an exported method of an exported type.
func (c *Catalog) Resolve() string { return c.Name }

func (c *Catalog) fill() { c.size = len(c.Name) }

type catalog struct{ Name string }

// Resolve is an exported method of an unexported type.
func (c *catalog) Resolve() string { return c.Name }

// Fetcher declares one exported and one unexported method.
type Fetcher interface {
	Fetch() error
	fetch() error
}

// Best declares a type parameter, which a caller supplies by position.
func Best[T comparable](want, have T) bool { return want == have }

// Sentinel is an exported variable.
var Sentinel = errors.New("sentinel")

var _ = Sentinel

// Named holds what the blank declaration above it holds.
var Named = Sentinel

func init() {}

// TestOutsideATestFile carries a test function's name and signature in a file the
// package itself compiles.
func TestOutsideATestFile(t *testing.T) { _ = t }
