func (p SQLPayload) hidden() int { return p.Extra }

// StoreSQL hands a pointer to an unrelated package.
func StoreSQL(m *sync.Map, p *SQLPayload) { m.Store("sql", p) }

// RowsPayload is the scan target of no row set.
