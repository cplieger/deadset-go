-- sorting.go --
package flow

import "sync"

// SortPayload is never converted to the sort interface, although it could be.
type SortPayload struct {
	Names  []string `sort:"names"`
	Extra  int
	secret string `sort:"secret"`
}

// Len is one of the three the interface requires.
func (p SortPayload) Len() int { return len(p.Names) }

// Less is one of the three the interface requires.
func (p SortPayload) Less(i, j int) bool { return p.Names[i] < p.Names[j] }

// Swap is one of the three the interface requires.
func (p SortPayload) Swap(i, j int) { p.Names[i], p.Names[j] = p.Names[j], p.Names[i] }

// Describe is exported.
func (p SortPayload) Describe() string { return p.Names[0] }

func (p SortPayload) hidden() int { return p.Extra }

// StoreSort hands a value to an unrelated package.
func StoreSort(m *sync.Map, p SortPayload) { m.Store("sort", p) }
-- logvalue.go --
package flow

import (
	"log/slog"
	"sync"
)

// LogPayload is converted to the log-value interface, which no destination of the
// class is: what a handler reads of such a value is what the method returns.
type LogPayload struct {
	Name   string `log:"name"`
	Extra  int
	secret string `log:"secret"`
}

// LogValue is what the interface requires.
func (p LogPayload) LogValue() slog.Value { return slog.StringValue(p.Name) }

// Describe is exported.
func (p LogPayload) Describe() string { return p.Name }

func (p LogPayload) hidden() int { return p.Extra }

// StoreLog hands a value to an unrelated package.
func StoreLog(m *sync.Map, p LogPayload) { m.Store("log", p) }

var _ slog.LogValuer = LogPayload{}
-- containers.go --
package flow

import "sync"

// Deep reaches no encoder.
type Deep struct {
	Name   string `json:"name"`
	Extra  int
	secret string `json:"secret"`
	Inner  Inner  `json:"inner"`
}

// Describe is exported.
func (d Deep) Describe() string { return d.Name }

func (d Deep) hidden() int { return d.Extra }

// Inner is the type of a field of Deep.
type Inner struct {
	Label string `json:"label"`
}

// Describe is exported.
func (i Inner) Describe() string { return i.Label }

// StoreDeep hands a container to an unrelated package.
func StoreDeep(m *sync.Map, values map[string][]*Deep) { m.Store("deep", values) }
-- writer.go --
package flow

import "sync"

// Sink is the writer of no template execution.
type Sink struct {
	Buffer []byte `sink:"buffer"`
	Extra  int
}

// Write is what an execution would need of it.
func (s *Sink) Write(p []byte) (int, error) {
	s.Buffer = append(s.Buffer, p...)
	return len(p), nil
}

func (s *Sink) hidden() int { return s.Extra }

// StoreSink hands the writer to an unrelated package.
func StoreSink(m *sync.Map, s *Sink) { m.Store("sink", s) }
