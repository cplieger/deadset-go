A library whose exported type embeds a standard-library buffer, which promotes a
method taking an io.Reader, and a type of the library that implements it.

-- go.mod --
module example.com/published

go 1.27
-- published.go --
package published

import (
	"bytes"
	"io"
)

// Sink is a buffer an outside program reads into.
type Sink struct {
	*bytes.Buffer
}

// Source is a reader an outside program can pass to the buffer.
type Source struct{}

func (Source) Read(p []byte) (int, error) { return 0, io.EOF }
