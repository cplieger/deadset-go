Two iota groups whose types no conversion method covers: one whose values are
produced by converting an integer read off the wire, and one carried by a struct
field a decoder writes. Neither package names a member beyond the zero value.

-- go.mod --
module example.com/enumwire

go 1.27.1
-- level/level.go --
package level

import (
	"encoding/json"
	"errors"
)

// Level is the enumerated type, and a value of it is produced by conversion.
type Level int

const (
	LevelOff Level = iota
	LevelWarn
	LevelError
)

// Decode reads a number off the wire and converts it, so a Level value arrives
// without any member being named.
func Decode(data []byte) (Level, error) {
	var n int
	if err := json.Unmarshal(data, &n); err != nil {
		return LevelOff, err
	}
	if n < 0 {
		return LevelOff, errors.New("level below zero")
	}
	return Level(n), nil
}
-- record/record.go --
package record

import "encoding/json"

// Kind is the enumerated type, and a decoder writes a field that carries it.
type Kind int

const (
	KindUnknown Kind = iota
	KindFile
	KindDirectory
)

// Entry is the decoded document.
type Entry struct {
	Kind Kind   `json:"kind"`
	Name string `json:"name"`
}

// Read decodes one entry, so a Kind value arrives from outside the program.
func Read(data []byte) (Entry, error) {
	var e Entry
	err := json.Unmarshal(data, &e)
	return e, err
}
