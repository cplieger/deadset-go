One package whose types declare the method a verb would call and never reach a
verb that calls it: a numeric verb, the default verb under the sharp flag, which
asks for a Go-syntax representation instead, a scanning function of the same
package, the function of the package that formats a verb rather than an operand, an
operand an explicit index steps over, a function of the package that takes a
variadic list of any and never passes it on, and a pair that pass such a list to
each other and to nothing that formats. The class records nothing here.

-- go.mod --
module example.com/verbs

go 1.27.1
-- numeric.go --
package verbs

import "fmt"

// Numeric reaches a verb that formats a number.
type Numeric struct{ Count int }

// String is the method no verb here calls.
func (v Numeric) String() string { return "n" }

// Total is exported and of another shape.
func (v Numeric) Total() int { return v.Count }

// RenderNumeric formats the value itself under verbs that ask for no string.
func RenderNumeric(v Numeric) string { return fmt.Sprintf("%d %t %T %p", v, v, v, &v) }
-- sharp.go --
package verbs

import "fmt"

// Sharp reaches the default verb under the sharp flag.
type Sharp struct{ Name string }

// String is the method the sharp flag does not reach.
func (v Sharp) String() string { return v.Name }

// Total is exported and of another shape.
func (v Sharp) Total() int { return len(v.Name) }

// RenderSharp formats under the sharp flag.
func RenderSharp(v Sharp) string { return fmt.Sprintf("%#v", v) }
-- scanned.go --
package verbs

import (
	"fmt"
	"io"
)

// Scanned reaches a scanning function, which reads rather than formats.
type Scanned struct{ Name string }

// String is the method no scan calls.
func (v Scanned) String() string { return v.Name }

// Total is exported and of another shape.
func (v Scanned) Total() int { return len(v.Name) }

// ScanName reads into a field.
func ScanName(r io.Reader, v *Scanned) error {
	_, err := fmt.Fscanf(r, "%s", &v.Name)
	return err
}
-- verb_formatting.go --
package verbs

import "fmt"

// Formatted reaches the function that formats a verb rather than an operand.
type Formatted struct{ Name string }

// String is the method that function does not call.
func (v Formatted) String() string { return v.Name }

// Total is exported and of another shape.
func (v Formatted) Total() int { return len(v.Name) }

// Format renders the verb of a state, and the operand of that call is the state.
func (v Formatted) Format(s fmt.State, verb rune) {
	_, _ = s.Write([]byte(fmt.FormatString(s, verb)))
}
-- not_forwarded.go --
package verbs

// Counted reaches a function of this package that takes a variadic list of any and
// never passes it on.
type Counted struct{ Name string }

// String is the method nothing here calls.
func (v Counted) String() string { return v.Name }

// Total is exported and of another shape.
func (v Counted) Total() int { return len(v.Name) }

// Collected reaches a pair of functions that pass such a list on to each other and
// to nothing that formats.
type Collected struct{ Name string }

// String is the method nothing here calls.
func (v Collected) String() string { return v.Name }

// Total is exported and of another shape.
func (v Collected) Total() int { return len(v.Name) }

// count reads how many operands it was given and formats none of them.
func count(args ...any) int { return len(args) }

// collect passes its operands to a function that formats none of them.
func collect(args ...any) []any { return join(args...) }

// join keeps the operands it is given.
func join(parts ...any) []any { return parts }

// CountOperands hands a value to the function that counts its operands.
func CountOperands(v Counted) int { return count(v) }

// CollectOperands hands a value to the pair that keep their operands.
func CollectOperands(v Collected) []any { return collect(v) }
-- indexed.go --
package verbs

import "fmt"

// Stepped is the operand an explicit index steps over, and the format consumes no
// other, so nothing renders it.
type Stepped struct{ Name string }

// String is the method no verb here calls.
func (v Stepped) String() string { return v.Name }

// Total is exported and of another shape.
func (v Stepped) Total() int { return len(v.Name) }

// RenderStepped formats the second operand under a numeric verb.
func RenderStepped(stepped Stepped, n int) string { return fmt.Sprintf("%[2]d", stepped, n) }
