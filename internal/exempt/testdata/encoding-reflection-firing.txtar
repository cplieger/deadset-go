-- reflection.go --
package flow

import "reflect"

// ReflectPayload reaches reflection.
type ReflectPayload struct {
	Name   string `reflect:"name"`
	Extra  int
	secret string `reflect:"secret"`
}

// Describe is exported.
func (p ReflectPayload) Describe() string { return p.Name }

func (p ReflectPayload) hidden() int { return p.Extra }

// Inspect hands a value to reflection.
func Inspect(p ReflectPayload) string { return reflect.ValueOf(p).Kind().String() }
-- sql.go --
package flow

import "database/sql"

// SQLPayload is a scan target.
type SQLPayload struct {
	Name   string `db:"name"`
	Extra  int
	secret string `db:"secret"`
}

// Describe is exported.
func (p SQLPayload) Describe() string { return p.Name }

func (p SQLPayload) hidden() int { return p.Extra }

// ScanRow hands a pointer to the scan of one row.
func ScanRow(row *sql.Row) (SQLPayload, error) {
	var p SQLPayload
	err := row.Scan(&p)
	return p, err
}

// RowsPayload is the scan target of a row set.
type RowsPayload struct {
	Name   string `db:"name"`
	Extra  int
	secret string `db:"secret"`
}

// Describe is exported.
func (p RowsPayload) Describe() string { return p.Name }

func (p RowsPayload) hidden() int { return p.Extra }

// ScanRows hands a pointer to the scan of a row set.
func ScanRows(rows *sql.Rows) (RowsPayload, error) {
	var p RowsPayload
	err := rows.Scan(&p)
	return p, err
}

// ValuePayload reaches the scan as a value rather than as a pointer.
type ValuePayload struct {
	Name   string `db:"name"`
	Extra  int
	secret string `db:"secret"`
}

// Describe is exported.
func (p ValuePayload) Describe() string { return p.Name }

func (p ValuePayload) hidden() int { return p.Extra }

// ScanValue hands the scan a pointer to no defined type, and a value that is no
// pointer, neither of which the class reads.
func ScanValue(row *sql.Row, p ValuePayload) error {
	var name string
	return row.Scan(&name, p)
}
-- sorting.go --
package flow

import "sort"

// SortPayload is converted to the sort interface.
type SortPayload struct {
	Names  []string `sort:"names"`
	Extra  int
	secret string `sort:"secret"`
}

// Len is one of the three the interface requires.
func (p SortPayload) Len() int { return len(p.Names) }

// Less is one of the three the interface requires.
func (p SortPayload) Less(i, j int) bool { return p.Names[i] < p.Names[j] }

// Swap is one of the three the interface requires.
func (p SortPayload) Swap(i, j int) { p.Names[i], p.Names[j] = p.Names[j], p.Names[i] }

// Describe is exported.
func (p SortPayload) Describe() string { return p.Names[0] }

func (p SortPayload) hidden() int { return p.Extra }

// SortNames converts a value to the interface.
func SortNames(p SortPayload) { sort.Sort(p) }
-- logging.go --
package flow

import "log/slog"

// LogPayload is an operand of a structured-logging call.
type LogPayload struct {
	Name   string `log:"name"`
	Extra  int
	secret string `log:"secret"`
}

// LogValue is what the handler calls where it finds it.
func (p LogPayload) LogValue() slog.Value { return slog.StringValue(p.Name) }

// Describe is exported.
func (p LogPayload) Describe() string { return p.Name }

func (p LogPayload) hidden() int { return p.Extra }

// LogPayloadValue hands a value to a logging call.
func LogPayloadValue(p LogPayload) { slog.Info("payload", "value", p) }
-- containers.go --
package flow

import "encoding/json"

// Deep is reached through a map of slices of pointers.
type Deep struct {
	Name   string `json:"name"`
	Extra  int
	secret string `json:"secret"`
	Inner  Inner  `json:"inner"`
}

// Describe is exported.
func (d Deep) Describe() string { return d.Name }

func (d Deep) hidden() int { return d.Extra }

// Inner is the type of a field of a type the encoder reaches, and the reach
// stops before it.
type Inner struct {
	Label string `json:"label"`
}

// Describe is exported.
func (i Inner) Describe() string { return i.Label }

// EncodeDeep hands a container to the encoder.
func EncodeDeep(m map[string][]*Deep) ([]byte, error) { return json.Marshal(m) }
-- writer.go --
package flow

import "text/template"

// Sink is the writer of a template execution, which is an argument of a function
// of the package like any other.
type Sink struct {
	Buffer []byte `sink:"buffer"`
	Extra  int
}

// Write is what the execution needs of it.
func (s *Sink) Write(p []byte) (int, error) {
	s.Buffer = append(s.Buffer, p...)
	return len(p), nil
}

func (s *Sink) hidden() int { return s.Extra }

// RenderInto hands the writer to the engine.
func RenderInto(t *template.Template, s *Sink) error { return t.Execute(s, nil) }
