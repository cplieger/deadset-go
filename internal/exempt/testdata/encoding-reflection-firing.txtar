-- gob.go --
package flow

import (
	"encoding/gob"
	"io"
)

// GobPayload reaches the gob encoder.
type GobPayload struct {
	Name   string `gob:"name"`
	Extra  int
	secret string `gob:"secret"`
}

// Describe is exported.
func (p GobPayload) Describe() string { return p.Name }

func (p GobPayload) hidden() int { return p.Extra }

// EncodeGob hands a value to the encoder through a method of the package.
func EncodeGob(w io.Writer, p GobPayload) error { return gob.NewEncoder(w).Encode(p) }
-- text_template.go --
package flow

import (
	"io"
	"text/template"
)

// TextPayload reaches the text template engine.
type TextPayload struct {
	Name   string `template:"name"`
	Extra  int
	secret string `template:"secret"`
}

// Describe is exported.
func (p TextPayload) Describe() string { return p.Name }

func (p TextPayload) hidden() int { return p.Extra }

// RenderText hands a value to the engine.
func RenderText(t *template.Template, p TextPayload) error { return t.Execute(io.Discard, p) }
