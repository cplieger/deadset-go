Five types answering interfaces no expression converts them to: one reaches a
type parameter's constraint as a type argument, one reaches an empty interface
that a type assertion then narrows to another interface, one reaches the empty
interface in a test file alone, one reaches it in a test file of one package and
in a source file of another, and one reaches no interface at all. Six more reach
constraints that name a type parameter: a generic constraint holding a pointer
term, a generic constraint whose method takes the parameter, a constraint written
in place holding a pointer term, a constraint written in place whose method takes
the parameter, one whose method takes a struct holding the parameter, and one
whose method returns a generic type instantiated at the parameter.

-- go.mod --
module example.com/structural

go 1.27.0
-- structural.go --
// Package structural holds types an interface reaches only structurally.
package structural

type closer interface{ Close() error }

type namer interface{ Name() string }

type instantiated struct{}

func (instantiated) Close() error { return nil }

type asserted struct{}

func (asserted) Name() string { return "asserted" }

type tested struct{}

func (tested) Name() string { return "tested" }

// Shared is converted by a test file of one package and a source file of another.
type Shared struct{}

// Name answers namer.
func (Shared) Name() string { return "shared" }

type unreached struct{}

func (unreached) Name() string { return "unreached" }

func shut[T closer](v T) error { return v.Close() }

// Shut closes a value through a constraint.
func Shut() error { return shut(instantiated{}) }

// Held boxes a value in an empty interface.
func Held() any { return asserted{} }

// NameOf names a value an assertion finds to be a namer.
func NameOf(v any) string {
	if n, ok := v.(namer); ok {
		return n.Name()
	}
	return unreached{}.Name()
}
-- generic.go --
package structural

type pathed[T any] interface {
	*T
	Path() string
}

type file struct{ path string }

func (f *file) Path() string { return f.path }

func pathOf[T any, PT pathed[T]](v *T) string { return PT(v).Path() }

// PathOf reads a path through a generic constraint holding a pointer term.
func PathOf() string { return pathOf(&file{path: "p"}) }

type lesser[T any] interface{ Less(T) bool }

type rank int

func (r rank) Less(other rank) bool { return r < other }

func least[T lesser[T]](a, b T) T {
	if b.Less(a) {
		return b
	}
	return a
}

// Least orders two ranks through a constraint whose method takes the parameter.
func Least() rank { return least(rank(1), rank(2)) }

type tagged struct{ label string }

func (t *tagged) Label() string { return t.label }

func labelOf[T any, PT interface {
	*T
	Label() string
}](v *T) string {
	return PT(v).Label()
}

// LabelOf reads a label through a constraint written in place.
func LabelOf() string { return labelOf(&tagged{label: "l"}) }

type weight int

func (w weight) Heavier(other weight) bool { return w > other }

func heaviest[T interface{ Heavier(T) bool }](a, b T) T {
	if b.Heavier(a) {
		return b
	}
	return a
}

// Heaviest orders two weights through a constraint written in place whose method
// takes the parameter.
func Heaviest() weight { return heaviest(weight(1), weight(2)) }

type linked struct{ name string }

func (l linked) Follow(hop struct{ next linked }) linked { return hop.next }

func follow[T interface{ Follow(struct{ next T }) T }](v T) T {
	return v.Follow(struct{ next T }{next: v})
}

// Follow follows a link through a constraint whose method takes a struct holding
// the parameter.
func Follow() linked { return follow(linked{name: "n"}) }

type box[T any] struct{ v T }

type coin int

func (c coin) Boxed() box[coin] { return box[coin]{v: c} }

func boxed[T interface{ Boxed() box[T] }](v T) box[T] { return v.Boxed() }

// Boxed boxes a coin through a constraint whose method returns a generic type
// instantiated at the parameter.
func Boxed() box[coin] { return boxed(coin(1)) }
-- a_test.go --
package structural

import "testing"

func TestNameOf(t *testing.T) {
	if NameOf(tested{}) != "tested" {
		t.Error("NameOf(tested{}) is not tested")
	}
}
-- user/user.go --
// Package user names a shared value.
package user

import "example.com/structural"

// Name names the shared value.
func Name() string { return structural.NameOf(structural.Shared{}) }
-- aa/aa.go --
// Package aa sorts before user and converts the shared value only in its test.
package aa
-- aa/aa_test.go --
package aa

import (
	"testing"

	"example.com/structural"
)

func TestShared(t *testing.T) {
	if structural.NameOf(structural.Shared{}) != "shared" {
		t.Error("the shared value is not named shared")
	}
}
