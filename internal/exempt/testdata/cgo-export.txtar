A function exported to C in a file importing "C". The load compiles with cgo
disabled and then type-checks the file from its original sources with the C
pseudo-package opaque, so the file is among the syntax the class walks.

-- go.mod --
module example.com/app

go 1.27.0
-- app.go --
package app

// Size is what the package publishes.
func Size() int { return 0 }
-- export.go --
package app

/*
#include <stdlib.h>
*/
import "C"

//export Exported
func Exported() {}
