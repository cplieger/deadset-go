One assembly file beside a package's Go files. Rule N reads no assembly form, so
every constant, type, struct field, variable, function and method of the package
is retained, the ones the file names in a TEXT directive, a GLOBL, a comment or
not at all alike, against the assembly file's first line.

-- go.mod --
module example.com/app

go 1.27.0
-- add.go --
package app

func add(x, y int) int

// Sum adds through the assembly routine.
func Sum(x, y int) int { return add(x, y) }
-- names.go --
package app

func fileLocal()

func commented() {}

func other() {}

var data int

const width = 8

type pair struct{ left int }
-- add_amd64.s --
#include "textflag.h"

// TEXT ·commented(SB), NOSPLIT, $0-24
TEXT ·add(SB), NOSPLIT, $0-24
	MOVQ x+0(FP), AX
	MOVQ y+8(FP), BX
	ADDQ BX, AX
	MOVQ AX, ret+16(FP)
	RET

	TEXT ·fileLocal<>(SB), NOSPLIT, $0
	RET

TEXT example·other(SB), NOSPLIT, $0
	RET

TEXT ·missing(SB), NOSPLIT, $0
	RET

GLOBL ·data(SB), RODATA, $8
