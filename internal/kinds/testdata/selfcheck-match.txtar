One library package whose records each match, or fail to match, the finding the
code they name would produce: a part record on a published method, two unused
parameters under one directive, a liveness record naming the wrong code, and a
part record on a read parameter of a helper only a dead function calls.

-- go.mod --
module example.com/selfcheckmatch

go 1.27.1
-- lib.go --
package selfcheckmatch

// Store holds nothing.
type Store struct{}

//deadset:ignore DS1801 -- published method whose parameter the body never names
func (*Store) Get(key string) string { return "v" }

//deadset:ignore DS1801 -- two unused parameters under one record
func Pair(a, b int) int { return 1 }

//deadset:ignore DS1001 -- the wrong code: the finding is DS1002
func hidden() int { return 2 }

func deadCaller() int { return helper(3) }

//deadset:ignore DS1801 -- the parameter is read, so this matches nothing
func helper(n int) int { return n }

//deadset:ignore DS1002,DS1801 -- the mark holds spare back, and its parameter is read
func spare(n int) int { return n }
