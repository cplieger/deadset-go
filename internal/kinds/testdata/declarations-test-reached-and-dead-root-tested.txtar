The package of declarations-test-reached-beside-a-dead-root.txtar with one test
calling both the helper and the function nothing else calls.

-- go.mod --
module example.com/app

go 1.27.1
-- main.go --
package main

import "example.com/app/core"

func main() { println(core.Live()) }
-- main_test.go --
package main

import (
	"testing"

	"example.com/app/core"
	"example.com/app/helpers"
)

func TestBoth(t *testing.T) {
	if helpers.Make() != core.Legacy() {
		t.Fail()
	}
}
-- core/core.go --
package core

// Live is what the command calls.
func Live() int { return 0 }

// Legacy is called by nothing.
func Legacy() int { return shared() + only() }

// Shared is called by the helper alone.
func Shared() int { return shared() }

func shared() int { return 1 }

func only() int { return 2 }
-- helpers/helpers.go --
package helpers

import "example.com/app/core"

// Make is called by the test alone.
func Make() int { return core.Shared() }
