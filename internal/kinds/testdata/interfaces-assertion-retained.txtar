A satisfaction assertion an exemption retains: a generated file of a package nothing
imports declares the interface, the type and the assertion, so the generated-file
exemption holds every declaration the sweep would otherwise find dead.

-- go.mod --
module example.com/app

go 1.27.0
-- main.go --
package main

func main() {}
-- store/querier.go --
// Code generated by a generator. DO NOT EDIT.

package store

// Querier runs the queries.
type Querier interface {
	Run() error
}

// Queries runs the queries against one connection.
type Queries struct{}

// Run runs one query.
func (*Queries) Run() error { return nil }

var _ Querier = (*Queries)(nil)
