A function nothing calls converts a type to an interface its method satisfies,
and the command converts it to the same interface later in the file.

-- go.mod --
module example.com/app

go 1.27
-- main.go --
package main

import "io"

type sink struct{ n int }

func (s *sink) Write(p []byte) (int, error) { return len(p), nil }

func spare() io.Writer { return &sink{} }

func main() {
	var w io.Writer = &sink{}
	println(w != nil)
}
